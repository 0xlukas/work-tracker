        }
      }
    },
    "A verified backup is saved daily while the app is running (skipped when nothing changed). The latest 30 are kept on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange die App läuft, wird täglich ein geprüftes Backup gespeichert (ausser wenn sich nichts geändert hat). Die letzten 30 bleiben auf diesem Mac."
          }
        }
      }
    },
